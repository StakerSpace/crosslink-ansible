# Managed by Ansible (crosslink-ansible). The chain this host is on, for
# crosslink-check and crosslink-stake. crosslink_chains in group_vars.
NETWORK={{ crosslink_network }}
STAKING_PERIOD_BLOCKS={{ crosslink_chain.staking_period_blocks }}
STAKING_WINDOW_BLOCKS={{ crosslink_chain.staking_window_blocks }}
STAKING_ACTION_DELAY_BLOCKS={{ crosslink_chain.staking_action_delay_blocks | default(0) }}
STAKING_START_BLOCK={{ crosslink_chain.staking_start_block | default(0) }}
ROSTER_BLOCK={{ crosslink_chain.roster_block | default(0) }}
BFT_ACTIVATION_BLOCK={{ crosslink_chain.activation_block | default(0) }}
ACTIVE_ROSTER_MAX={{ crosslink_chain.active_roster_max | default(0) }}
BLOCKS_PER_MINUTE={{ crosslink_chain.blocks_per_minute }}
